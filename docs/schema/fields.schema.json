{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iyulab/openquote/blob/main/docs/schema/fields.schema.json",
  "title": "Openquote field definitions",
  "description": "fields/<pack>/<type>/v<version>.json. Format 1 lets a coded field take many values and a field give a fixed first value. Field names are unique within the file, and a constraint never names a field the same file declares; a reader checks both.",
  "type": "object",
  "required": ["format", "pack", "type", "version"],
  "properties": {
    "format": { "enum": ["openquote.fields/0", "openquote.fields/1"] },
    "pack": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "not": { "enum": ["local", "oq"] } },
    "type": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "constrain": { "type": "array", "items": { "$ref": "#/$defs/constraint" } }
  },
  "if": { "properties": { "format": { "const": "openquote.fields/0" } } },
  "then": {
    "properties": {
      "fields": {
        "items": {
          "not": { "anyOf": [ { "required": ["many"] }, { "required": ["default"], "properties": { "default": { "anyOf": [ { "required": ["value"] }, { "required": ["year"] } ] } } } ] }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "field": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["text", "date", "number", "coded", "reference", "references"] },
        "scheme": { "$ref": "#/$defs/text" },
        "type": { "$ref": "#/$defs/text" },
        "required": { "type": "boolean" },
        "many": { "type": "boolean" },
        "tier": { "enum": ["structured", "narrative"] },
        "default": {
          "type": "object",
          "oneOf": [
            { "required": ["subject"], "not": { "required": ["value"] } },
            { "required": ["value"], "not": { "anyOf": [ { "required": ["subject"] }, { "required": ["year"] } ] } }
          ],
          "properties": {
            "subject": { "$ref": "#/$defs/text" },
            "value": { "anyOf": [ { "$ref": "#/$defs/text" }, { "type": "number" } ] },
            "year": { "$ref": "#/$defs/year" }
          }
        },
        "label": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "coded" } } },
          "then": { "required": ["scheme"] },
          "else": { "not": { "required": ["scheme"] } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["reference", "references"] } } },
          "then": { "required": ["type"] },
          "else": { "not": { "required": ["type"] } }
        },
        {
          "if": { "required": ["many"], "properties": { "many": { "const": true } } },
          "then": { "properties": { "kind": { "const": "coded" } } }
        },
        {
          "if": { "required": ["default"], "properties": { "default": { "required": ["value"] } } },
          "then": {
            "properties": { "kind": { "enum": ["text", "number", "coded"] } },
            "if": { "properties": { "kind": { "const": "number" } } },
            "then": { "properties": { "default": { "properties": { "value": { "type": "number" } } } } },
            "else": { "properties": { "default": { "properties": { "value": { "$ref": "#/$defs/text" } } } } }
          }
        }
      ]
    },
    "year": {
      "type": "object",
      "required": ["then"],
      "properties": {
        "startMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
        "then": { "enum": ["advance", "drop"] },
        "max": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            {
              "type": "object",
              "required": ["subject", "by"],
              "properties": {
                "subject": { "$ref": "#/$defs/text" },
                "by": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 1 } }
              }
            }
          ]
        }
      },
      "if": { "required": ["max"] },
      "then": { "properties": { "then": { "const": "advance" } } }
    },
    "constraint": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "required": { "const": true },
        "hidden": { "const": true }
      },
      "anyOf": [ { "required": ["required"] }, { "required": ["hidden"] } ]
    }
  }
}
