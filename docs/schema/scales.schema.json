{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iyulab/openquote/blob/main/docs/schema/scales.schema.json",
  "title": "Openquote scales",
  "description": "scales/<pack>/v<version>.json.",
  "type": "object",
  "required": ["format", "pack", "version", "responses", "scales"],
  "properties": {
    "format": { "const": "openquote.scales/0" },
    "pack": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "not": { "enum": ["local", "oq"] } },
    "version": { "type": "integer", "minimum": 1 },
    "responses": {
      "type": "object",
      "required": ["type", "scale", "score"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "not": { "enum": ["subject", "group", "practitioner", "device"] } },
        "scale": { "type": "string", "minLength": 1 },
        "score": { "type": "string", "minLength": 1 }
      }
    },
    "scales": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "required": ["direction", "min", "max"],
        "properties": {
          "direction": { "enum": ["lower-is-better", "higher-is-better"] },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "licence": {
            "type": "object",
            "required": ["terms"],
            "properties": {
              "terms": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
            }
          }
        }
      }
    }
  }
}
