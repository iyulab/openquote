{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iyulab/openquote/blob/main/docs/schema/labels.schema.json",
  "title": "Openquote labels",
  "description": "labels/<pack>/v<version>.<locale>.json.",
  "type": "object",
  "required": ["format", "pack", "version", "locale"],
  "properties": {
    "format": { "const": "openquote.labels/0" },
    "pack": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "not": { "enum": ["local", "oq"] } },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "schemes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[1-9][0-9]*$" },
        "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/label" } }
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/label" }
    },
    "fields": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/label" } }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/label" } }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[1-9][0-9]*$" },
        "additionalProperties": { "$ref": "#/$defs/label" }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[1-9][0-9]*$" },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "label": { "$ref": "#/$defs/label" },
            "columns": {
              "type": "object",
              "propertyNames": { "pattern": "^(?:0|[1-9][0-9]*)$" },
              "additionalProperties": { "$ref": "#/$defs/label" }
            }
          },
          "anyOf": [ { "required": ["label"] }, { "required": ["columns"], "properties": { "columns": { "minProperties": 1 } } } ]
        }
      }
    }
  },
  "$defs": { "label": { "type": "string", "minLength": 1 } }
}
