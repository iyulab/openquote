{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iyulab/openquote/blob/main/docs/schema/export.schema.json",
  "title": "Openquote export form",
  "description": "exports/<export>/v<version>.json. Each column has exactly one source, recognised in the order people, person, year, field + ref, field + scheme + version, field.",
  "type": "object",
  "required": ["format", "export", "version", "label", "rows", "period", "columns"],
  "properties": {
    "format": { "const": "openquote.export/0" },
    "export": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "label": { "type": "string", "minLength": 1 },
    "rows": { "type": "string", "minLength": 1 },
    "period": {
      "type": "object",
      "required": ["field"],
      "properties": { "field": { "type": "string", "minLength": 1 } }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "column": {
      "type": "object",
      "required": ["label"],
      "properties": { "label": { "$ref": "#/$defs/text" } },
      "oneOf": [
        {
          "required": ["people"],
          "properties": { "people": { "const": "count" } }
        },
        {
          "required": ["person"],
          "not": { "required": ["people"] },
          "properties": { "person": { "$ref": "#/$defs/text" }, "all": { "type": "boolean" } }
        },
        {
          "required": ["year", "startMonth"],
          "not": { "anyOf": [ { "required": ["people"] }, { "required": ["person"] } ] },
          "properties": { "year": { "$ref": "#/$defs/text" }, "startMonth": { "type": "integer", "minimum": 1, "maximum": 12 } }
        },
        {
          "required": ["field", "ref"],
          "not": { "anyOf": [ { "required": ["people"] }, { "required": ["person"] }, { "required": ["year"] } ] },
          "properties": { "field": { "$ref": "#/$defs/text" }, "ref": { "$ref": "#/$defs/text" } }
        },
        {
          "required": ["field", "scheme", "version"],
          "not": { "anyOf": [ { "required": ["people"] }, { "required": ["person"] }, { "required": ["year"] }, { "required": ["ref"] } ] },
          "properties": {
            "field": { "$ref": "#/$defs/text" },
            "scheme": { "$ref": "#/$defs/text" },
            "version": { "type": "integer", "minimum": 1 },
            "part": { "enum": ["top", "item"] }
          }
        },
        {
          "required": ["field"],
          "not": { "anyOf": [ { "required": ["people"] }, { "required": ["person"] }, { "required": ["year"] }, { "required": ["ref"] }, { "required": ["scheme"] } ] },
          "properties": { "field": { "$ref": "#/$defs/text" } }
        }
      ]
    }
  }
}
