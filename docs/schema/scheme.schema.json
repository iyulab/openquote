{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iyulab/openquote/blob/main/docs/schema/scheme.schema.json",
  "title": "Openquote classification scheme version",
  "description": "schemes/<scheme>/v<version>.json. Codes are unique within a version and a parent names another item of the same version; a reader checks both.",
  "type": "object",
  "required": ["format", "scheme", "version", "items"],
  "properties": {
    "format": { "const": "openquote.scheme/0" },
    "scheme": { "$ref": "#/$defs/name" },
    "version": { "type": "integer", "minimum": 1 },
    "effective": {
      "type": "object",
      "required": ["from"],
      "properties": {
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "label"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "parent": { "type": "string", "minLength": 1 },
          "suggest": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
