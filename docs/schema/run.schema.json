{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iyulab/openquote/blob/main/docs/schema/run.schema.json",
  "title": "Openquote report run record",
  "description": "runs/<yyyy>/<id>.<device>.json. The report form it names must be in the vault, total must equal the cells plus pending plus unmapped, and people must name exactly the records in total; a reader checks all three. Counts are derived from records.",
  "type": "object",
  "required": ["format", "id", "device", "at", "report", "schemes", "period", "cells", "pending", "unmapped", "total"],
  "properties": {
    "format": { "const": "openquote.run/0" },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "device": { "type": "string", "pattern": "^[a-z0-9]{4,16}$" },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$" },
    "report": {
      "type": "object",
      "required": ["report", "version"],
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "schemes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["version"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "crosswalks": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*-[1-9][0-9]*$" } }
        }
      }
    },
    "period": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["row", "column", "records"],
        "properties": {
          "row": { "type": "string", "minLength": 1 },
          "column": { "type": ["string", "null"] },
          "count": { "type": "integer", "minimum": 0 },
          "records": { "$ref": "#/$defs/ids" }
        }
      }
    },
    "pending": { "$ref": "#/$defs/set" },
    "unmapped": { "$ref": "#/$defs/set" },
    "total": { "$ref": "#/$defs/set" },
    "people": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ids" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "ids": { "type": "array", "items": { "type": "string" } },
    "set": {
      "type": "object",
      "required": ["records"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "records": { "$ref": "#/$defs/ids" }
      }
    }
  }
}
