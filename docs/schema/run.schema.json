{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iyulab/openquote/blob/main/docs/schema/run.schema.json",
  "title": "Openquote report run record",
  "description": "runs/<yyyy>/<id>.<device>.json. The report form it names must be in the vault, a format 1 cell's key holds one place per dimension of the form — a code where it is classified, a string or null elsewhere, and null where the subjects a record is about have no single value — and a format 0 cell a row and a column (or null); total must equal the cells plus pending, unmapped, blank and conflicted with each record in exactly one of them, and people must name exactly the records in total; a reader checks all three. In format 0, blank is optional and lists records that are also in unmapped. Counts are derived from records.",
  "type": "object",
  "required": ["format", "id", "device", "at", "report", "schemes", "period", "cells", "pending", "unmapped", "total"],
  "properties": {
    "format": { "enum": ["openquote.run/0", "openquote.run/1"] },
    "multiple": { "const": true, "description": "Format 1, when the form counts every value of a field: a record may be in several cells and in one set besides." },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "device": { "type": "string", "pattern": "^[a-z0-9]{4,16}$" },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$" },
    "report": {
      "type": "object",
      "required": ["report", "version"],
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "schemes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["version"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "crosswalks": { "type": "array", "items": { "type": "string", "pattern": "^([1-9][0-9]*-[1-9][0-9]*|[^/]+/[1-9][0-9]*-[^/]+/[1-9][0-9]*)$" } },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "from", "to"],
              "properties": {
                "date": { "$ref": "#/$defs/date" },
                "from": { "type": ["integer", "null"], "minimum": 1 },
                "to": { "type": ["integer", "null"], "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "period": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["records"],
        "properties": {
          "row": { "type": "string", "minLength": 1 },
          "column": { "type": ["string", "null"] },
          "key": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": ["string", "null"] } },
          "count": { "type": "integer", "minimum": 0 },
          "records": { "$ref": "#/$defs/ids" }
        }
      }
    },
    "pending": { "$ref": "#/$defs/set" },
    "unmapped": { "$ref": "#/$defs/set" },
    "blank": { "$ref": "#/$defs/set", "description": "Records whose row field holds no value to count. Required in format 1, where they are in no other set; optional in format 0, where each is also in unmapped." },
    "conflicted": { "$ref": "#/$defs/set", "description": "Format 1 only, and required there. Records a field the form places by holds concurrent values for." },
    "total": { "$ref": "#/$defs/set" },
    "people": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ids" } }
  },
  "if": { "properties": { "format": { "const": "openquote.run/1" } } },
  "then": {
    "required": ["blank", "conflicted"],
    "properties": { "cells": { "items": { "required": ["key"], "not": { "anyOf": [{ "required": ["row"] }, { "required": ["column"] }] } } } }
  },
  "else": {
    "not": { "anyOf": [{ "required": ["conflicted"] }, { "required": ["multiple"] }] },
    "properties": { "cells": { "items": { "required": ["row", "column"], "not": { "required": ["key"] } } } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "ids": { "type": "array", "items": { "type": "string" } },
    "set": {
      "type": "object",
      "required": ["records"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "records": { "$ref": "#/$defs/ids" }
      }
    }
  }
}
