<Project>

  <!--
    The C# examples of the public documents are compiled with the tests, so an example that names a
    type or member the engine no longer has fails the build rather than a reader. Every ```csharp
    block of README.md and docs/*.md becomes the body of a method (its `using` lines go to the top; a
    `vault` folder path is in scope) in a generated file under obj/; `#line` points compiler messages
    at the document and line the code came from.
  -->

  <ItemGroup>
    <DocExampleSource Include="$(MSBuildThisFileDirectory)..\..\README.md;$(MSBuildThisFileDirectory)..\..\docs\*.md" />
  </ItemGroup>

  <UsingTask TaskName="WriteDocExamples" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Documents ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var usingLine = new Regex(@"^using [A-Za-z][\w.]*;\s*$");
        var usings = new SortedSet<string>(StringComparer.Ordinal);
        var methods = new List<string>();
        foreach (var document in Documents.OrderBy(d => d.ItemSpec, StringComparer.Ordinal))
        {
            var path = Path.GetFullPath(document.ItemSpec);
            var lines = File.ReadAllLines(path);
            for (var i = 0; i < lines.Length; i++)
            {
                if (lines[i].Trim() != "```csharp") continue;
                var start = i + 1;
                var end = start;
                while (end < lines.Length && lines[end].Trim() != "```") end++;
                var body = new List<string>();
                for (var j = start; j < end; j++)
                {
                    if (usingLine.IsMatch(lines[j])) { usings.Add(lines[j].Trim()); body.Add(""); }
                    else body.Add(lines[j]);
                }
                methods.Add(string.Join("\n", new[]
                {
                    "    internal static void Example" + methods.Count + "(string vault)",
                    "    {",
                    "#line " + (start + 1) + " \"" + path.Replace('\\', '/') + "\"",
                }.Concat(body).Concat(new[] { "#line default", "    }" })));
                i = end;
            }
        }
        var text = string.Join("\n", new[]
        {
            "// <auto-generated>Generated from the C# examples of the documents for the build.</auto-generated>",
            "#pragma warning disable",
        }.Concat(usings).Concat(new[]
        {
            "",
            "namespace Openquote.DocExamples;",
            "",
            "internal static class Examples",
            "{",
            string.Join("\n\n", methods),
            "}",
            "",
        }));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(OutputFile)));
            File.WriteAllText(OutputFile, text);
        }
        Log.LogMessage(MessageImportance.Low, "{0} C# example(s) of the documents compiled with the tests", methods.Count);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CompileDocExamples" BeforeTargets="CoreCompile">
    <!-- Set here, not at evaluation: this file is imported before the SDK sets the intermediate path. -->
    <PropertyGroup>
      <DocExamplesFile>$(IntermediateOutputPath)DocExamples.g.cs</DocExamplesFile>
    </PropertyGroup>
    <WriteDocExamples Documents="@(DocExampleSource)" OutputFile="$(DocExamplesFile)" />
    <ItemGroup>
      <Compile Include="$(DocExamplesFile)" />
      <FileWrites Include="$(DocExamplesFile)" />
    </ItemGroup>
  </Target>

</Project>
